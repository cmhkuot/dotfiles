# Open WebUI configuration
#
# fresh.sh copies this file to .env and fills in WEBUI_SECRET_KEY.
# .env is gitignored because it holds secrets.
#
# IMPORTANT - two kinds of settings exist:
#
#   1. Runtime env vars (this file). Read from the environment on every boot,
#      so editing them here always takes effect.
#   2. Persistent config (webui.db). Open WebUI seeds these from env vars on
#      FIRST boot only; afterwards the database wins and this file is ignored.
#      Sync those with bin/webui-config.sh instead.
#
# Only the vars below are worth keeping here. Everything else is either an
# unchanged default or belongs in webui-config.json.

# --- Read by compose, not by the app ---------------------------------------

# Host port. Avoid 3000/3001/5173/8080 - they clash with Next.js, Vite and CRA
# dev servers. 11435 sits next to Ollama (11434) and no framework claims it.
WEBUI_PORT=11435

# Host data directory (webui.db, cache, uploads, vector_db).
# Leave unset to default to $HOME/.local/share/open-webui
# WEBUI_DATA_DIR=

# --- Runtime: always effective ---------------------------------------------

# JWT signing key. Losing it invalidates every session. Generated by fresh.sh.
WEBUI_SECRET_KEY=

# Updates happen through `webui_update`, so skip the nag and the outbound call
ENABLE_VERSION_UPDATE_CHECK=false

# Persist each message as it streams instead of only at the end of a reply.
# Off by default for multi-user load; on a single-user box it just means a
# crashed tab or container never loses a conversation.
ENABLE_REALTIME_CHAT_SAVE=true

# --- Persistent config: seeds the database on FIRST boot only ---------------
# Changing these later does nothing. Use `webui_config import` instead.

# Ollama runs natively on the host via brew services
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Personal machine: one admin account, no open registration
ENABLE_SIGNUP=false

# Escape hatch: reseeds every persistent config value from env on next boot,
# discarding admin settings made through the UI. Export first.
# RESET_CONFIG_ON_START=true
